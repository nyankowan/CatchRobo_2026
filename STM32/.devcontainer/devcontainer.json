{
	"name": "STM32",
	"build": {
		"dockerfile": "Dockerfile"
	},
	// STM32/*/CMakeLists.txt reach outside this folder (../common and
	// ../../common), so mount the whole repository instead of just STM32/,
	// and default the editor into STM32/ for convenience. All four STM32
	// firmware projects (lower_arm_servo, upper_arm_servo, robomas_controller,
	// assemble_servo) share this same container/toolchain.
	"workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces/CatchRobo_2026,type=bind,consistency=cached",
	"workspaceFolder": "/workspaces/CatchRobo_2026/STM32",
	"postCreateCommand": "git config --global --add safe.directory /workspaces/CatchRobo_2026",
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			},
			"extensions": [
				// This repo's .clangd files already target clangd, so use it
				// here too instead of ms-vscode.cpptools.
				"llvm-vs-code-extensions.vscode-clangd",
				"ms-vscode.cmake-tools",
				"marus25.cortex-debug"
			]
		}
	},
	"runArgs": ["--privileged"]
}
