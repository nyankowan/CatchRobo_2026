{
	"name": "ESP-IDF QEMU",
	"build": {
		"dockerfile": "Dockerfile"
	},
	// ESP32/controller/CMakeLists.txt reaches outside this folder
	// (../../common), so mount the whole repository instead of just this
	// folder, and default the editor into ESP32/controller for convenience.
	"workspaceMount": "source=${localWorkspaceFolder}/../..,target=/workspaces/CatchRobo_2026,type=bind,consistency=cached",
	"workspaceFolder": "/workspaces/CatchRobo_2026/ESP32/controller",
	"postCreateCommand": "git config --global --add safe.directory /workspaces/CatchRobo_2026",
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"idf.gitPath": "/usr/bin/git"
			},
			"extensions": [
				"espressif.esp-idf-extension",
				"espressif.esp-idf-web"
			]
		}
	},
	"runArgs": ["--privileged"]
}